# Ktor
PORT=8080
PUBLIC_BASE_URL=https://your-api.example.com
CORS_ALLOWED_ORIGINS=https://telegram-video-editor-platform-pipeline-integrated.ngogiaidy3.workers.dev

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://telegram-video-editor-platform-pipeline-integrated.ngogiaidy3.workers.dev/telegram/webhook
# Comma separated Telegram numeric user IDs
TELEGRAM_ADMIN_IDS=6138197737

# AI
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# FFmpeg
FFMPEG_BIN=ffmpeg
WORK_DIR=./server/data

# Security
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400
PIPELINE_PROJECT_DIR=.
PIPELINE_DRY_RUN_COMMAND=npm run dry-run --prefix pipeline-ui
EDGE_SHARED_SECRET=generate-a-long-random-secret
TELEGRAM_REGISTER_WEBHOOK=false
