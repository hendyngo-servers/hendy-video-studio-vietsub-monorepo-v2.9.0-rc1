PORT=3000
NODE_ENV=development
PUBLIC_URL=https://hendy-video-studio-new-pro.onrender.com
ADMIN_GATEWAY_URL=https://hendy-video-studio-new-pro.onrender.com/admin-console/network-gateway
GEMINI_API_KEY=
# Admin origin protection: require a Cloudflare Access JWT for admin pages and APIs.
# Set these to the Access application protecting admin.hendystudio.net.
ADMIN_ACCESS_ISSUER=
ADMIN_ACCESS_AUD=
# Comma-separated email allowlist; only these identities can operate admin APIs.
ADMIN_ACCESS_EMAILS=admin@example.com
# Local-only convenience for loopback development; production hosts always require Cloudflare Access.
ADMIN_ACCESS_ALLOW_LOCAL_DEV=true
# Configure a high-entropy secret for the legacy admin-gateway HMAC handshake.
DEDICATED_ADMIN_GATEWAY_SECRET=

# Optional legacy Telegram bot passcode. Leave blank to disable passcode auth.
ADMIN_PASSCODE=
